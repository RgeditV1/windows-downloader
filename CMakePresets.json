{
    "version": 8,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Configure cmake to release",
            "description": "Sets Ninja generator, build and install directory",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/bin/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "./3rdparty/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/install/${presetName}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "description": "",
            "displayName": "",
            "configurePreset": "default"
        }
    ]
}